{
  "name": "atlanta-walkwise",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names Web,API \"npm:dev:web\" \"npm:dev:api\"",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "start": "tsx server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "format": "prettier --write src shared server tests vite.config.ts",
    "test:ui": "node scripts/verify-ui.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^6.9.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "concurrently": "^10.0.5",
    "jsdom": "^29.1.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "vite": "^7.1.5",
    "vitest": "^4.1.11"
  }
}
